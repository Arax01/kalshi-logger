# No API keys are needed. Everything this logger reads is public market data.
# Copy this file to ".env" only if you want to change a setting below.
# The real ".env" file is excluded from git.

# How often each job runs (seconds)
# SCAN_INTERVAL_SEC=1200
# CRYPTO_INTERVAL_SEC=120
# INGAME_INTERVAL_SEC=60

# Maximum requests per second sent to Kalshi (kept well below their limit)
# KALSHI_MAX_RPS=2

# Leagues for in-game logging (comma separated, Kalshi league names)
# INGAME_LEAGUES=NFL,NBA,MLB,NHL,NCAAFB
